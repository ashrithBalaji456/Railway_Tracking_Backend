# ==============================================================================
# RailTrack India — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# Do NOT commit '.env' to git repositories.

# Database Configuration (Defaults to in-memory H2 if omitted)
DATABASE_URL=jdbc:postgresql://localhost:5432/railtrack_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# Redis Configuration (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=d2FudC10by10cmFjay10cmFpbnMtc2VjdXJlLWtleS0yNTYtYml0LXZhbHVlLXRvLWJlLXJlcGxhY2VkLWluLXByb2R1Y3Rpb24=

# RailRadar API
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
