# ==============================================================================
# RailTrack India — Backend Environment Configuration Template
# ==============================================================================
# Use this reference when setting Environment Variables on Render / Cloud.

# Server Port (Render sets this automatically, default 8080 locally)
PORT=8080

# Frontend URL for CORS (comma-separated if multiple, e.g. production + preview)
FRONTEND_URL=https://your-frontend.onrender.com,http://localhost:5173

# Database Configuration (Render PostgreSQL)
# You can paste Render's Internal Database URL directly (postgres://... or jdbc:postgresql://...)
DATABASE_URL=postgres://user:password@dpg-xxxx.oregon-postgres.render.com/railtrack_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password_here

# Redis Configuration (Optional - Render Key-Value / Redis)
# Supports Render's REDIS_URL directly or host/port
REDIS_URL=redis://default:password@red-xxxx:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
# Base64-encoded secret key (minimum 256 bits)
JWT_SECRET=d2FudC10by10cmFjay10cmFpbnMtc2VjdXJlLWtleS0yNTYtYml0LXZhbHVlLXRvLWJlLXJlcGxhY2VkLWluLXByb2R1Y3Rpb24=

# RailRadar API (Live Indian Railways telemetry data)
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Gemini AI API (RailAI Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
